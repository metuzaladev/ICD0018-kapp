# Copy to .env.local. EXPO_PUBLIC_* values are bundled into the app — never put secrets here.

# API origin. Simulator: localhost works. Physical phone: use your computer's LAN IP.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Show social sign-in buttons only when the API has the matching credentials configured.
EXPO_PUBLIC_AUTH_APPLE=false
EXPO_PUBLIC_AUTH_GOOGLE=false
