NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Matches docker-compose.yml
DATABASE_URL=postgres://kapp:kapp@localhost:5432/kapp

# Authentication (Better Auth). Generate a secret: openssl rand -base64 32
# Required in production; development falls back to a fixed insecure value.
BETTER_AUTH_SECRET=
API_PUBLIC_URL=http://localhost:3000
APP_SCHEME=kapp

# Optional social sign-in — see docs/07-autentimine.md. Leave empty to disable.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_ID=ee.icd0018.kapp
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dog photos: S3-compatible object storage (docs/10-koerad-ja-tervis.md).
# Development: MinIO from docker-compose.yml (`npm run db:up` creates the private bucket).
# Production: Cloudflare R2 — S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto.
S3_ENDPOINT=http://localhost:9000
# Address the phone/simulator uses for photo URLs (signed for this host). Real phone: http://<computer-IP>:9000
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=kapp-photos
# Required in production; development falls back to the MinIO credentials in docker-compose.yml.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Realtime and push notifications (docs/12-kogukond.md).
# Redis for the BullMQ push queue — matches docker-compose.yml.
REDIS_URL=redis://localhost:6379
PUSH_QUEUE_PREFIX=kapp
# Only needed when "Enhanced security for push notifications" is on in the Expo project.
EXPO_ACCESS_TOKEN=
# false when a separate worker process sends the pushes.
PUSH_WORKER_ENABLED=true

# Production / several instances (docs/15-pakendamine-ja-levitamine.md); defaults suit development.
# TRUST_PROXY: false | <number of proxies> | <comma-separated proxy IPs/CIDRs> | true (not recommended)
TRUST_PROXY=false
RATE_LIMIT_STORE=memory
REALTIME_ADAPTER=memory
SHUTDOWN_TIMEOUT_MS=9000
LOG_LEVEL=
