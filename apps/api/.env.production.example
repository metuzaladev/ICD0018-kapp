# Production configuration template (docs/15-pakendamine-ja-levitamine.md).
# Copy to the hosting platform's secret store (or api.env for docker-compose.prod.yml).
# NEVER commit real values. The API refuses to start in production when a required value is
# missing or still a development default, and lists every problem at once.

NODE_ENV=production
PORT=3000
# Number of proxies in front of the API (load balancer = 1) or their CIDRs. Not "true".
TRUST_PROXY=1
LOG_LEVEL=info
# Below the platform's stop grace period (Docker 10 s, Fly kill_timeout, Render 30 s).
SHUTDOWN_TIMEOUT_MS=9000

# Managed Postgres 17 + PostGIS in the EU. Require TLS when the provider supports it.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/kapp?sslmode=require
# Managed Redis in the EU (BullMQ push/reminder queues, shared rate limits, Socket.IO adapter).
# Must not evict keys (maxmemory-policy noeviction), otherwise queued jobs can disappear.
REDIS_URL=rediss://default:PASSWORD@HOST:6379
PUSH_QUEUE_PREFIX=kapp

# Public https origin of the API (password-reset links, OAuth callbacks, Secure cookies).
API_PUBLIC_URL=https://api.example.ee
APP_SCHEME=kapp
# openssl rand -base64 32 — rotating it signs everybody out.
BETTER_AUTH_SECRET=
# Browsers are denied unless listed (https only). The mobile app sends no Origin and needs nothing.
CORS_ORIGINS=

# Social sign-in (docs/07-autentimine.md). Leave empty to disable.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_ID=ee.icd0018.kapp
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare R2 bucket created with EU jurisdiction (endpoint contains ".eu.").
S3_ENDPOINT=https://ACCOUNT_ID.eu.r2.cloudflarestorage.com
S3_PUBLIC_ENDPOINT=
S3_REGION=auto
S3_BUCKET=kapp-photos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Expo push: only when "Enhanced security for push notifications" is on.
EXPO_ACCESS_TOKEN=
# false on API instances when a separate worker process (same image) runs the BullMQ workers
# (push, booking reminders, email, storage cleanup of deleted accounts).
PUSH_WORKER_ENABLED=true

# Email (docs/17): password reset, email confirmation, account deletion confirmation.
# resend (HTTP API; create the domain in the EU region) or smtp (any SMTP server, e.g. an EU provider).
# `log` is refused in production. The From domain needs SPF and DKIM records for the provider.
MAIL_PROVIDER=resend
MAIL_FROM=Käpp <noreply@example.ee>
# Resend API key with "sending access" only.
RESEND_API_KEY=
# Only for MAIL_PROVIDER=smtp: smtps://user:password@smtp.example.eu:465
SMTP_URL=

# More than one API instance: share rate-limit counters and Socket.IO emits through Redis.
RATE_LIMIT_STORE=memory
REALTIME_ADAPTER=memory
