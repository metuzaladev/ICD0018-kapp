{
  "name": "icd0018-kapp",
  "version": "0.1.0",
  "private": true,
  "description": "Käpp — dog park and dog care app. TalTech ICD0018 Hybrid Mobile Applications course project.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:api": "npm run dev -w @kapp/api",
    "dev:mobile": "npm run start -w mobile",
    "db:up": "docker compose up -d --wait && docker compose run --rm minio-setup",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w @kapp/api",
    "db:seed": "npm run db:seed -w @kapp/api",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p scripts",
    "test": "npm run test --workspaces --if-present && npm run test:scripts",
    "test:scripts": "vitest run --root scripts",
    "lint": "npm run lint --workspaces --if-present",
    "i18n:check": "tsx scripts/i18n-check.ts",
    "a11y:check": "tsx scripts/a11y-check.ts",
    "legal:build": "tsx scripts/legal-build.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
