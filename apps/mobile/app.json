{
  "expo": {
    "name": "Käpp",
    "slug": "kapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "ee.icd0018.kapp",
      "usesAppleSignIn": true,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F1419",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ee.icd0018.kapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F1419",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#C8643C"
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Käpp kasutab sinu asukohta, et näidata lähimaid koeraparke ja nende kaugust. Asukohta ei jagata teistega ilma sinu loata."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Käpp vajab ligipääsu sinu piltidele, et saaksid valida fotosid oma koera profiili jaoks. Pildi asukohaandmed eemaldatakse enne salvestamist.",
          "cameraPermission": "Käpp kasutab kaamerat, et saaksid oma koerast pilti teha. Pildi asukohaandmed eemaldatakse enne salvestamist.",
          "microphonePermission": false
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "et",
              "en",
              "ru"
            ],
            "android": [
              "et",
              "en",
              "ru"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "locales": {
      "et": "./src/i18n/native/et.json",
      "en": "./src/i18n/native/en.json",
      "ru": "./src/i18n/native/ru.json"
    }
  }
}
