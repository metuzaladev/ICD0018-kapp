NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Matches docker-compose.yml
DATABASE_URL=postgres://kapp:kapp@localhost:5432/kapp

# Authentication (Better Auth). Generate a secret: openssl rand -base64 32
# Required in production; development falls back to a fixed insecure value.
BETTER_AUTH_SECRET=
API_PUBLIC_URL=http://localhost:3000
APP_SCHEME=kapp

# Optional social sign-in — see docs/07-autentimine.md. Leave empty to disable.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_ID=ee.icd0018.kapp
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
